{
  "name": "agent-as-a-service",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings packages scripts examples",
    "test": "node --import tsx scripts/quality/test.ts",
    "quality": "node --import tsx scripts/quality/check.ts",
    "quality:coverage": "node --import tsx scripts/quality/test.ts --coverage",
    "quality:mutation": "stryker run scripts/quality/stryker.config.json && node --import tsx scripts/quality/mutation.ts",
    "quality:test": "vitest run --config scripts/quality/vitest.tests.ts",
    "quality:baseline": "node --import tsx scripts/quality/check.ts --baseline",
    "openapi": "node --import tsx scripts/openapi.ts",
    "start": "node --import tsx examples/server-express/src/main.ts",
    "demo:express": "node --import tsx examples/client/demo.ts",
    "demo:opencode": "node --import tsx examples/server-opencode/src/demo.ts",
    "demo:node-red": "node --import tsx examples/server-node-red/src/demo.ts",
    "demo:node-red-agents": "node --import tsx examples/server-node-red-agents/src/demo.ts",
    "start:node-red-agents": "node --import tsx examples/server-node-red-agents/src/main.ts",
    "start:node-red": "node --import tsx examples/server-node-red/src/main.ts",
    "start:opencode": "node --import tsx examples/server-opencode/src/main.ts",
    "dev": "node --watch --import tsx examples/server-express/src/main.ts",
    "validate:openapi": "node --import tsx scripts/validate-openapi.ts",
    "check:parity": "node --import tsx scripts/check-parity.ts",
    "catalog": "node --import tsx scripts/catalog.ts",
    "parity:doc": "node --import tsx scripts/parity-doc.ts",
    "format": "prettier --write \"packages/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"scripts/quality/*.json\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"scripts/quality/*.json\""
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "zod": "^3.25.0",
    "zod-openapi": "^4.2.4"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
