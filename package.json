{
  "name": "agent-as-a-service",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --ignore-pattern=packages/node-red-host/lib/run-output.cjs packages scripts examples",
    "test": "vitest run",
    "test:contract": "vitest run packages/contract",
    "openapi": "node --import tsx scripts/openapi.ts",
    "start": "node --import tsx examples/server-express/src/main.ts",
    "demo:express": "node --import tsx examples/client/demo.ts",
    "demo:opencode": "node --import tsx examples/server-opencode/src/demo.ts",
    "demo:node-red": "node --import tsx examples/server-node-red/src/demo.ts",
    "demo:node-red-agents": "node --import tsx examples/server-node-red-agents/src/demo.ts",
    "start:node-red-agents": "node --import tsx examples/server-node-red-agents/src/main.ts",
    "start:node-red": "node --import tsx examples/server-node-red/src/main.ts",
    "start:opencode": "node --import tsx examples/server-opencode/src/main.ts",
    "dev": "node --watch --import tsx examples/server-express/src/main.ts",
    "validate:openapi": "node --import tsx scripts/validate-openapi.ts",
    "check:parity": "node --import tsx scripts/check-parity.ts",
    "catalog": "node --import tsx scripts/catalog.ts",
    "parity:doc": "node --import tsx scripts/parity-doc.ts",
    "format": "prettier --write \"packages/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\""
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "zod": "^3.25.0",
    "zod-openapi": "^4.2.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
