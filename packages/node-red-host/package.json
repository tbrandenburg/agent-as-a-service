{
  "name": "@tbrandenburg/node-red-host",
  "version": "0.1.0",
  "description": "Disposable execution host for a separately installed Node-RED runtime",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "aaas-node-red-host": "bin/aaas-node-red-host.cjs"
  },
  "files": ["bin/", "lib/", "LICENSE", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.cjs",
