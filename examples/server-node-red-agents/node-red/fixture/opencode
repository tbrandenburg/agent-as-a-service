#!/usr/bin/env node
const { randomUUID } = require("node:crypto");

if (process.argv.includes("--version")) {
  process.stdout.write("1.18.33\n");
  process.exit(0);
}
const prompt = process.argv.at(-1) ?? "";
const duration = prompt.startsWith("In one sentence, draft a release note") ? 365_000 : 100;
setTimeout(() => {
  const sessionID = `fixture-${randomUUID()}`;
  const event = { type: "text", sessionID, part: { text: `Fixture response to ${prompt}` } };
  process.stdout.write(`${JSON.stringify(event)}\n`);
}, duration);
