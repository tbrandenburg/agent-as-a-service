{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["examples/server-node-red-agents/src/managed.ts"],
  "testRunner": "command",
  "plugins": [],
  "commandRunner": {
    "command": "node node_modules/vitest/vitest.mjs run --config scripts/quality/vitest.mutation.ts"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 5000,
  "dryRunTimeoutMinutes": 2,
  "disableTypeChecks": false,
  "thresholds": { "high": 80, "low": 60, "break": null },
  "reporters": ["clear-text", "json", "html"],
  "clearTextReporter": { "reportMutants": false, "reportTests": false },
  "jsonReporter": { "fileName": "data/quality/mutation/mutation.json" },
  "htmlReporter": { "fileName": "data/quality/mutation/index.html" },
  "tempDirName": "data/quality/stryker-tmp",
  "ignorePatterns": [".worktrees/**", "data/**", "**/node_modules/**"]
}
